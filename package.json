{
	"name": "@sigrea/vue",
	"version": "0.7.1",
	"description": "Vue 3 composables for Sigrea molecules and signals.",
	"keywords": [
		"molecule",
		"reactivity",
		"signals",
		"typescript",
		"vue"
	],
	"homepage": "https://github.com/sigrea/vue#readme",
	"bugs": {
		"url": "https://github.com/sigrea/vue/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sigrea/vue.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vp dev --config playground/vite.config.ts",
		"build": "vp pack",
		"prepack": "vp pack",
		"smoke": "node --input-type=module -e \"const mod = await import('@sigrea/vue'); for (const key of ['useMolecule', 'useSignal']) { if (typeof mod[key] !== 'function') throw new Error(key + ' export is missing'); }\" && node -e \"const mod = require('@sigrea/vue'); for (const key of ['useMolecule', 'useSignal']) { if (typeof mod[key] !== 'function') throw new Error(key + ' export is missing'); }\"",
		"changelog": "changelogen",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"typecheck": "vp check --no-fmt --no-lint",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"cicheck": "vp check && vp test run && vp pack && vp run smoke",
		"prepare": "vp config --no-agent",
		"playground:build": "vp build --config playground/vite.config.ts"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@sigrea/core": "^0.7.0",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "catalog:",
		"@vue/test-utils": "^2.4.0",
		"changelogen": "^0.6.2",
		"jsdom": "^24.1.3",
		"typescript": "5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vue": "^3.4.0"
	},
	"peerDependencies": {
		"@sigrea/core": "^0.7.0",
		"vue": "^3.4.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
